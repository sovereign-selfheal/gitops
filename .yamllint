---
extends: default

# Helm templates are Go templates, not plain YAML: they are checked with
# `helm lint` and by rendering them (scripts/render.sh) instead.
ignore: |
  */templates/
  components/*/templates/
  rendered/
  components/*/files/

rules:
  line-length:
    max: 160
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  document-start: disable
